# Copy this file to .env and fill it in. `npm start` and `docker compose` both read .env.
# The server checks these at startup and refuses to start if something is wrong.

# production requires RESEARCH_KEY and a build in STATIC_DIR.
NODE_ENV=production

# Port the server listens on (and, with Docker, the port published on the host).
PORT=3000

# Protects the researcher dashboard (/researcher) and every export. At least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RESEARCH_KEY=

# Where the study data (JSON lines) is written. Docker always uses /data inside
# the container, which is the calibra-data volume, so this only matters for npm start.
DATA_DIR=data

# The built participant app (npm run build).
STATIC_DIR=dist

# Optional: a different folder of task definitions.
# TASK_DIR=tasks
